# =============================================================================
# Coitz Barbearia — Environment Variables
# =============================================================================

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# APP_ORIGIN: The origin domain for CORS and CSRF validation.
# Must match exactly the domain where your frontend is served.
# Example for Vercel: https://coitz-barbearia.vercel.app
APP_ORIGIN="http://localhost:5173"

# =============================================================================
# Security
# =============================================================================

# JWT secret — generate with: openssl rand -base64 64
# NEVER use a default value in production.
JWT_SECRET="CHANGE-ME-generate-a-strong-secret"

# =============================================================================
# Database (PostgreSQL / Supabase)
# =============================================================================

# Connection string with pgbouncer for serverless (port 6543)
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"

# OR individual connection variables
# SQL_HOST=
# SQL_USER=
# SQL_PASSWORD=
# SQL_DB_NAME=

# =============================================================================
# WhatsApp API (Ex: Evolution API, Z-API)
# =============================================================================

WHATSAPP_API_URL="https://sua-api-whatsapp.com/api"
WHATSAPP_API_TOKEN="seu-token-da-api-whatsapp"

# =============================================================================
# Rate Limiting (Upstash Redis — free tier)
# Create at: https://console.upstash.com/
# =============================================================================

UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Appointment rate limit: "requests,window" (default: 5,60s)
# RATE_LIMIT_APPOINTMENTS="5,60s"

# =============================================================================
# Development Only
# =============================================================================

# Set to "true" ONLY locally to enable the /api/setup seed route.
# NEVER configure this in Vercel Production.
# ALLOW_SEED="true"

# =============================================================================
# Observability & Cron (Backend Only)
# =============================================================================

# Sentry DSN for backend error tracking (do NOT prefix with VITE_)
# SENTRY_DSN="https://..."

# Secret used to authenticate the Vercel Cron requests
# Generate with: openssl rand -base64 32
# CRON_SECRET="your-cron-secret"
